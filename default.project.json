{
  "name": "roblox-game",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "SelectSport": {
          "$className": "RemoteEvent"
        },
        "SelectStance": {
          "$className": "RemoteEvent"
        },
        "RequestReset": {
          "$className": "RemoteEvent"
        },
        "ResetState": {
          "$className": "RemoteEvent"
        },
        "DevTeleport": {
          "$className": "RemoteEvent"
        },
        "RiderState": {
          "$className": "RemoteEvent"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "EnableMouseLockOption": false
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    }
  }
}
